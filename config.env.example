# Darts Scoreboard settings. Copy this file to config.env and fill it in:
#   cp config.env.example config.env
# config.env holds secrets (passwords, keys) and is ignored by git. Never commit it.
# Put values in single quotes, especially ones with special characters.

# ---------- Pi ----------
PI_HOST='192.168.1.50'            # address of the Autodarts Pi on your network (used by deploy.sh)
SCOREBOARD_PORT=8080              # web port of the scoreboard

# ---------- Sign-in (recommended) ----------
# First user; becomes admin. Leave empty to keep the scoreboard open (no sign-in) until you add
# users yourself with: scoreboard-user add NAME
SCOREBOARD_ADMIN_USER=''
SCOREBOARD_ADMIN_PASSWORD=''      # secret. Leave empty to be asked during the install instead.

# ---------- Autodarts board (Alpine Linux on a Raspberry Pi 4 or 5) ----------
INSTALL_AUTODARTS=yes             # install the Autodarts board service (skipped if already installed)
AD_VERSION=''                     # empty = latest; or a version such as 2.0.2
AD_REINSTALL=no                   # yes = download Autodarts again (update or repair)
# Optimizations, used with INSTALL_AUTODARTS=yes:
OPT_CLOCK_SYNC=yes                # set the clock from the network before Autodarts starts
OPT_CPU_PERFORMANCE=yes           # CPU at full speed all the time (steadier detection)
OPT_WIFI_POWERSAVE_OFF=yes        # no Wi-Fi power saving (lower, steadier latency)
OPT_CAMERA_EXPOSURE=''            # empty = cameras on auto exposure; a number (e.g. 100) = fixed short exposure
OPT_DISABLE_BLUETOOTH=yes         # turn Bluetooth off
OPT_FAST_BOOT=yes                 # start services in parallel
OPT_OVERCLOCK=''                  # empty = stock clock; Pi 4: 2000; Pi 5: 2600, 2800 or 3000 (needs good cooling)
OPT_STATUS_LOGIN=yes              # board status at login, and the "ad" command

# ---------- Parts to install: yes / no ----------
INSTALL_PUBLIC_VIEW=yes           # read-only copy for sharing (served on 127.0.0.1:8081 only)
INSTALL_MAINTENANCE=yes           # weekly backup, daily log trim, hardware watchdog
INSTALL_LIGHTS=no                 # dartboard lights on a Tuya / Smart Life Wi-Fi plug
INSTALL_TAILSCALE=no              # internet access through Tailscale Funnel (see README)
INSTALL_KEEPALIVE=yes             # health check every 5 min: services, cameras, Funnel routes, boot package cache

# ---------- Lights (only with INSTALL_LIGHTS=yes) ----------
LIGHTS_DEVICE_ID=''               # Tuya device ID, e.g. bf0123456789abcdefxyz
LIGHTS_IP=''                      # plug's IP address; reserve it in your router
LIGHTS_LOCAL_KEY=''               # secret. Tuya local key (16 characters), see README
LIGHTS_VERSION=3.3                # Tuya protocol version shown by "tinytuya scan"
LIGHTS_IDLE_MINUTES=10            # off after this long without any board activity
LIGHTS_NO_SCORE_MINUTES=15        # off after this long without a new dart

# ---------- Tailscale (only with INSTALL_TAILSCALE=yes) ----------
TS_HOSTNAME='autodarts-pi'        # machine name; the address becomes https://<name>.<tailnet>.ts.net
TS_AUTHKEY=''                     # secret, optional: tskey-auth-... to log in without a browser link
TS_FUNNEL_PUBLIC=yes              # public read-only view at https://<name>.<tailnet>.ts.net/
TS_FUNNEL_PLAY=no                 # full scoreboard with sign-in at /play/ (needs a scoreboard user)
TS_HTTPS_REDIRECT=yes             # with TS_FUNNEL_PLAY=yes: send home-network visitors to the HTTPS /play/ address
